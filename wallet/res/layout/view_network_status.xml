<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/network_status_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_less_bright">

    <TextView
        style="@style/MontserratMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/network_monitor_spv_section_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_sync_mode_label" />

            <TextView
                android:id="@+id/network_status_mode_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_monitor_sync_unknown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_current_height_label" />

            <TextView
                android:id="@+id/network_status_height_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_monitor_sync_unknown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_peers_label" />

            <TextView
                android:id="@+id/network_status_peers_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_sync_progress_label" />

            <TextView
                android:id="@+id/network_status_progress_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_monitor_sync_unknown" />
        </LinearLayout>

        <TextView
            android:id="@+id/network_status_warning"
            style="@style/MontserratRegular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textColor="@android:color/holo_orange_dark"
            android:text=""
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/bg_bright" />

    <TextView
        style="@style/MontserratMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/network_monitor_api_section_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_api_status_label" />

            <TextView
                android:id="@+id/network_status_api_state_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/api_status_unknown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_api_tip_height_label" />

            <TextView
                android:id="@+id/network_status_api_height_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_monitor_sync_unknown" />
        </LinearLayout>

        <TextView
            android:id="@+id/network_status_height_diff_value"
            style="@style/MontserratRegular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/network_monitor_sync_unknown" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_api_difficulty_label" />

            <TextView
                android:id="@+id/network_status_api_difficulty_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_monitor_stat_unavailable" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_api_hashrate_label" />

            <TextView
                android:id="@+id/network_status_api_hashrate_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_monitor_stat_unavailable" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_api_masternodes_label" />

            <TextView
                android:id="@+id/network_status_api_masternodes_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_monitor_stat_unavailable" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_api_price_label" />

            <TextView
                android:id="@+id/network_status_api_price_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_monitor_stat_unavailable" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/MontserratRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/network_monitor_api_updated_label" />

            <TextView
                android:id="@+id/network_status_api_updated_value"
                style="@style/MontserratMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preferences_api_last_check_summary" />
        </LinearLayout>

        <TextView
            android:id="@+id/network_status_api_source_value"
            style="@style/MontserratRegular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="" />
    </LinearLayout>

</LinearLayout>
